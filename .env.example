# Core — copy to .env and rotate all demo secrets before any public deployment
APP_NAME=DealForge
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://dealforge:dealforge@postgres:5432/dealforge
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=replace-with-at-least-32-random-characters
ANONYMIZATION_SALT=replace-with-a-separate-random-secret
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAX_UPLOAD_BYTES=5242880

# Business / niche configuration
BUSINESS_NAME=Workspace Signal
NICHE=US home-office and workspace upgrades
DASHBOARD_USER=
DASHBOARD_PASSWORD=
TARGET_COUNTRY=US
CURRENCY=USD
MIN_PRICE=15
MAX_PRICE=1000
MIN_DISCOUNT_PERCENT=15
MIN_POSTS_PER_DAY=2
MAX_POSTS_PER_DAY=5
POSTING_WINDOWS=09:00-11:00,14:00-16:00,19:00-21:00
TIMEZONE=America/New_York
DEAL_MAX_AGE_HOURS=24

# Safety defaults — keep these values until quality and account access are validated
DEMO_MODE=true
DRY_RUN=true
AUTO_PUBLISH=false
ENABLE_TRACKING_REDIRECT=true
ENABLE_PAID_ADS=false

# AI (mock works without credentials)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INPUT_COST_PER_MILLION=0.25
OPENAI_OUTPUT_COST_PER_MILLION=2.00
DAILY_AI_BUDGET=3.00
MONTHLY_AI_BUDGET=50.00
TTS_PROVIDER=disabled

# Pinterest API v5 — obtain after creating a Pinterest business developer app
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/v1/integrations/pinterest/callback
PINTEREST_API_BASE=https://api.pinterest.com/v5

# Storage; local is used by Docker demo
STORAGE_PROVIDER=local
MEDIA_ROOT=/app/media/generated
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Paid promotion hard limits (feature remains disabled unless every gate is valid)
DAILY_AD_BUDGET=0
MONTHLY_AD_BUDGET=0
MAX_SPEND_PER_CONTENT=0
SEO_TAXONOMY_PATH=templates/seo_taxonomy.json
AFFILIATE_DIRECTORY_PATH=templates/affiliate_programs.json
SEO_MIN_EXPERIMENT_IMPRESSIONS=500
SEO_MIN_EXPERIMENT_CLICKS=20
SEO_MIN_EXPERIMENT_CONVERSIONS=3
SEO_KEYWORD_MAX_REPETITIONS=2
OPPORTUNITY_PROFIT_CONFIDENCE_THRESHOLD=65
ESTIMATED_MEDIA_COST_PER_CONTENT=0.03
INFRASTRUCTURE_COST_PER_CONTENT=0.10
MIN_ORGANIC_SIGNAL_BEFORE_PROMOTION=500
MIN_CTR=0.015
MIN_CONVERSION_SIGNAL=1

# Docker-only database values
POSTGRES_DB=dealforge
POSTGRES_USER=dealforge
POSTGRES_PASSWORD=dealforge
