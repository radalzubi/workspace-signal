FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY apps ./apps
COPY workers ./workers
COPY templates ./templates
COPY alembic.ini ./
COPY infrastructure/alembic ./infrastructure/alembic
RUN pip install .
RUN mkdir -p /app/media/generated && chown -R nobody:nogroup /app/media

USER nobody
EXPOSE 8000
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

